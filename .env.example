# ============================================================
# Exam Monitor Platform - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values
# Or set these as system environment variables

# Database Configuration
EM_DB_HOST=127.0.0.1
EM_DB_PORT=3306
EM_DB_NAME=exam_monitor
EM_DB_USER=root
EM_DB_PASS=

# Application Settings
EM_ENV=development
EM_BASE_URL=http://localhost:8000

# Moodle Sync Secret (must match Moodle plugin settings)
EM_SYNC_SECRET=em-sync-change-me

# License Activation Secret
EM_LICENSE_SECRET=em-license-secret-change-me

# Trial Period (days)
EM_TRIAL_DAYS=7
